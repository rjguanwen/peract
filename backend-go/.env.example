# ============ 基础 ============
PROJECT_NAME=躬行
# 生成密钥: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=please-change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ============ 服务与数据库 ============
# Go 后端端口（Python 后端使用 8000，Go 版本默认 8001）
PORT=8001
# SQLite（默认，零依赖，数据库文件在 backend-go 目录下）
DATABASE_URL=sqlite:///./task.db

# ============ 提醒通知（可选） ============
# IM Webhook（钉钉/企业微信/飞书）
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TYPE=generic        # generic / dingtalk / wecom / feishu
# SMTP 邮件
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# ============ 初始管理员 ============
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=admin123
INIT_ADMIN_EMAIL=admin@example.com
