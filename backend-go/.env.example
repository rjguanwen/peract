# ============================================================
# 躬行后端配置样例：复制为 .env 后按需修改
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)
# 留空的项走代码内默认值（见各项注释），未列出的键不会被读取。
# ============================================================

# ============ 基础 ============
PROJECT_NAME=躬行
# 运行环境：development（默认）/ production
# production 下弱密钥、默认管理员口令会被拒绝启动或告警，改动前先在开发环境验证
APP_ENV=development
# 签名密钥，务必改成强随机值：openssl rand -hex 32
# 保持占位值或短于 32 字符时，development 下只告警、production 下直接拒绝启动
SECRET_KEY=please-change-me-to-a-random-secret
# 访问令牌有效期（分钟），非正数回落到 7 天（10080）
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ============ 服务与数据库 ============
# Go 后端端口
PORT=8001
# 架构上固定 SQLite（纯 Go 驱动，无需 CGO，数据库文件就在 backend-go 目录下）。
# 填 postgres:// / mysql:// 等其他引擎连接串会在启动时直接报错退出，
# 不会被当成裸路径静默建出一个同名 SQLite 文件。
DATABASE_URL=sqlite:///./task.db
# 对外前端地址，用于拼重置密码 / 邀请邮件里的链接
APP_BASE_URL=http://localhost:5173
# 上传文件根目录（头像等），会以静态目录 /uploads 暴露
UPLOAD_DIR=./uploads

# ============ 运行期保护 ============
# 允许跨域的来源，逗号分隔；默认 * 仅供开发，生产请收敛为具体前端域名
CORS_ALLOW_ORIGINS=*
# 反向代理 IP 或 CIDR，逗号分隔。留空则完全不采信 X-Forwarded-For，
# 此时限流按代理 IP 计数、所有用户共用一份配额；置于 Nginx 之后必须填写，
# 否则伪造该头即可绕过登录限流
TRUSTED_PROXIES=
# 单个请求体上限（字节），默认 12MB，需容纳 5MB 头像表单
MAX_BODY_BYTES=12582912
# 优雅停机等待在途请求的上限（秒）
SHUTDOWN_TIMEOUT_SECONDS=10

# ============ 限流 ============
# 计数状态在进程内存中，仅对单实例部署有效；多实例横向扩容需换成共享存储
# 登录失败：window 秒内同一「来源 IP + 用户名」最多失败 limit 次，超限返回 429
LOGIN_FAIL_LIMIT=5
LOGIN_FAIL_WINDOW_SECONDS=600
# 找回密码等敏感接口：window 秒内同一「来源 IP + 邮箱」最多 limit 次
NOTIFY_LIMIT=3
NOTIFY_WINDOW_SECONDS=300

# ============ 提醒通知（可选） ============
# 外部通知走异步队列投递，不阻塞请求；队列满则丢弃并记日志
NOTIFY_WORKERS=2
NOTIFY_QUEUE_SIZE=256
# IM Webhook（钉钉/企业微信/飞书），留空则不推送
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TYPE=generic        # generic / dingtalk / wecom / feishu
WEBHOOK_TIMEOUT_SECONDS=5
# SMTP 邮件，HOST/USER/FROM 三者齐全才启用；密码亦可使用 SMTP_PASS 键名
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=躬行
SMTP_USE_TLS=true
SMTP_DIAL_TIMEOUT_SECONDS=10
SMTP_COMMAND_TIMEOUT_SECONDS=20

# ============ 初始管理员 ============
# 仅首次启动（该用户名不存在）时创建；口令保持 admin123 会打印告警
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=admin123
INIT_ADMIN_EMAIL=admin@example.com
